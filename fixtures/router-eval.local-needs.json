      "transport": "wechat",
      "text": "任务：找到 just-ddl 仓库并检查失败原因，不要执行",
      "expected_intent": "task_enqueue",
      "expected_owner_slot_id": "planner"
    },
    {
      "id": "english_task_webpage",
      "transport": "feishu",
      "text": "task write a small web page for the local status dashboard, do not publish",
      "expected_intent": "task_enqueue",
      "expected_owner_slot_id": "planner"
    },
    {
      "id": "upper_task_debug",
      "transport": "webview",
      "text": "TASK debug the failing Harvis Studio task cards, do not commit",
      "expected_intent": "task_enqueue",
      "expected_owner_slot_id": "planner"
    },
    {
      "id": "fsrealtask_xhs",
      "transport": "feishu",
      "text": "FSREALTASK202606280112 准备小红书发布前检查，不要发布",
      "expected_intent": "task_enqueue",
      "expected_owner_slot_id": "planner"
    },
    {
      "id": "repo_space_lookup",
      "transport": "wechat",
      "text": "repo just-ddl",
      "expected_intent": "repo_lookup",
