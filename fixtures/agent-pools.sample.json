{
  "version": "harvis.agent-pools.v0",
  "safety": {
    "includesSecrets": false,
    "includesCredentialValues": false,
    "includesCredentialPaths": false,
    "reviewGateRequired": true
  },
  "routing_policy": {
    "agent_identity_source": "agent-roster",
    "harness_selection": "task-capability",
    "model_selection": "task-capability",
    "fallback_mode": "ordered"
  },
  "harness_pool": [
    {
      "harness_id": "codex",
      "label": "Codex CLI",
      "kind": "codex",
      "status": "active",
      "command_aliases": [
        "codex",
        "cxgpt55"
      ],
      "adapter": {
        "mode": "cli",
        "prompt_input": "stdin",
        "result_output": "file"
      },
      "supports_model_override": true,
      "default_model_id": "openai:gpt-5.5",
      "allowed_model_ids": [
        "openai:gpt-5-codex",
        "openai:gpt-5.3-codex-spark",
        "openai:gpt-5.5"
      ],
      "review_gate": "required"
    },
    {
      "harness_id": "dsh",
      "label": "Digital-Me DSH",
      "kind": "dsh",
      "status": "active",
      "command_aliases": [
        "dsh",
        "digital-me"
      ],
      "adapter": {
        "mode": "cli",
        "prompt_input": "arg",
        "result_output": "file"
      },
      "supports_model_override": false,
      "default_model_id": "dsh:profile-default",
      "allowed_model_ids": [
        "dsh:profile-default"
      ],
      "review_gate": "required",
      "notes": "DSH/Cordis agent loop with the isolated Digital-Me profile; provider and model selection remain profile-owned."
