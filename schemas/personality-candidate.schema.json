{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harzva.local/harvis/schemas/personality-candidate.schema.json",
  "title": "H.A.R.V.I.S. Personality Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "target_persona_id",
    "source_type",
    "trait",
    "trait_type",
    "confidence",
    "stability",
    "risk",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^pc_[A-Za-z0-9T_-]+$"
    },
    "target_persona_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trait": {
      "type": "string",
      "minLength": 1
    },
    "trait_type": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stability": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "suggested_action": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending_review", "accepted", "edited", "rejected", "reject_forever", "deferred"]
    }
  }
}
