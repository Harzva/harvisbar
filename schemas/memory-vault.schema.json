{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harzva.local/harvis/schemas/memory-vault.schema.json",
  "title": "H.A.R.V.I.S. Memory Vault",
  "type": "object",
  "required": ["vault_id", "display_name", "owner", "status", "visibility"],
  "additionalProperties": true,
  "properties": {
    "vault_id": {
      "type": "string",
      "pattern": "^vault_[A-Za-z0-9_-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "disabled"]
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public_safe", "shared"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_items": {
      "type": "integer",
      "minimum": 0
    },
    "last_synced_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
