{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harvis.agent-room-mailbox.schema.json",
  "title": "H.A.R.V.I.S. Agent Room Mailbox Record",
  "type": "object",
  "required": ["record_type", "mail_id", "status"],
  "properties": {
    "record_type": { "enum": ["mailbox_item", "mailbox_status"] },
    "mail_id": { "type": "string", "minLength": 1 },
    "topic_id": { "type": "string" },
    "from_slot_id": { "type": "string" },
    "to_slot_id": { "type": "string" },
    "kind": { "type": "string" },
    "subject": { "type": "string" },
    "content": { "type": "string" },
    "status": { "enum": ["unread", "read"] },
    "source_event_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": ["string", "null"] },
    "safety": {
      "type": "object",
      "properties": {
        "executes_task": { "const": false },
        "record_only": { "const": true }
      }
    }
  },
  "additionalProperties": true
}
